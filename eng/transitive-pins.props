<Project>
  <!-- Transitive advisories pulled in by Umbraco.Automate.Core and the test harness. Pins lift the resolved version in every
       project, build and audit only (PrivateAssets=all keeps them off consumers). Delete a pin when upstream has caught up:
       a stale pin below what upstream needs fails restore with NU1109, so it cannot hide. Checked by build/check-vulnerable.sh.
         MessagePack 3.1.11                          GHSA-qhrr-8q5h-9q3h (moderate)
         System.Security.Cryptography.Pkcs 10.0.13   GHSA-846f-f764-76mx (high), GHSA-2fmv-rv2c-59x7 (moderate)
         System.Security.Cryptography.Xml 10.0.13    GHSA-r955-8q5j-3h83, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj (high) -->
  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.11" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>
</Project>
